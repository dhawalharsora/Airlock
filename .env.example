# ---- Model provider (swappable behind the provider interface) ----
MODEL_PROVIDER=bedrock            # bedrock | ollama | openai
AGENT_MODEL=anthropic.claude-haiku-4-5
JUDGE_MODEL=amazon.nova-lite
AWS_REGION=ap-southeast-2

# ---- AWS (Bedrock) — do NOT hardcode; use IAM roles/Secrets Manager in prod ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Local dev alternatives ----
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=

# ---- Postgres ----
DATABASE_URL=postgresql://airlock:airlock@localhost:5432/airlock

# ---- MCP ----
MCP_SERVER_URL=http://localhost:8081
